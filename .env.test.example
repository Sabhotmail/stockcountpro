# Test room — copy to .env.test and fill secrets. Never point these at production.
# Web: npm run start:test  →  http://<LAN-IP>:3001
# Express test instance must listen on 8081 (production stays on 8080).

APP_ENV=test

DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/stockcountpro_test

# Different from production AUTH_SECRET (cookies are host-wide, not port-specific)
AUTH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars

# AUTH_COOKIE_SECURE=false
# ACKNOWLEDGE_INSECURE_HTTP=true

ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password

EXPRESS_API_BASE_URL=http://100.95.113.104:8081
EXPRESS_API_USERNAME=admin
EXPRESS_API_PASSWORD=your-password-here

TZ=Asia/Bangkok
