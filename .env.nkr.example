# Temporary NKR room — copy to .env.nkr and fill secrets. Never point these at production.
# Web: npm run start:nkr  →  http://<LAN-IP>:3003
# Express NKR is a separate machine (same port 8080 as production, different IP).
# EXPRESS_API_BASE_URL=http://100.71.103.65:8080

APP_ENV=nkr

DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/stockcountpro_nkr

# Different from production and test AUTH_SECRET (cookies are host-wide, not port-specific)
AUTH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars

# AUTH_COOKIE_SECURE=false
# ACKNOWLEDGE_INSECURE_HTTP=true

ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
# ADMIN_BOOTSTRAP_BRANCH_CODE=NKR

EXPRESS_API_BASE_URL=http://100.71.103.65:8080
EXPRESS_API_USERNAME=admin
EXPRESS_API_PASSWORD=your-password-here

TZ=Asia/Bangkok
